{
  "uid": "av2-seguranca",
  "title": "Segurança e observabilidade",
  "description": "Os contadores de logins são acumulados desde o início do processo da aplicação.",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Logins válidos",
      "description": "Total desde o início do processo da aplicação.",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(seguranca_logins_validos_total)", "instant": true }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Logins inválidos",
      "description": "Total desde o início do processo da aplicação.",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(seguranca_logins_invalidos_total)", "instant": true }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Usuários bloqueados",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(seguranca_usuarios_bloqueados)", "instant": true }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value" }
    }
  ]
}
